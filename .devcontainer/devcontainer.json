{
    "name": "cpp-dev-container",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "GitHub.vscode-github-actions",
                "ms-azuretools.vscode-docker",
                "ms-python.python",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.makefile-tools"
            ]
        }
    },
    "remoteUser": "ubuntu",
    "mounts": [
        "source=${localEnv:HOME}/.local/state/proconenv-devcontainer/claude,target=/home/ubuntu/.claude,type=bind"
    ],
    "forwardPorts": [
        4000
    ],
    "remoteEnv": {
        "YUKICODER_TOKEN": "${localEnv:YUKICODER_TOKEN}"
    },
    "containerEnv": {
        "LANG": "ja_JP.UTF-8",
        "LANGUAGE": "ja_JP:ja",
        "TZ": "Asia/Tokyo",
        "CPLUS_INCLUDE_PATH": "/workspaces/proconenv/lib",
        "CLAUDE_CONFIG_DIR": "/home/ubuntu/.claude"
    },
    "initializeCommand": "mkdir -p \"${localEnv:HOME}/.local/state/proconenv-devcontainer/claude\"",
    "postCreateCommand": "bash .devcontainer/postCreateCommand.sh"
}
